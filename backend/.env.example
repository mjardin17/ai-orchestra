# Optional FREE keys, one per provider you want in your pool. No keys at all = Claude only.
# After adding a key, restart the app, then tick the models in the Models tab.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
DEEPSEEK_API_KEY=   # DeepSeek bills per token; new accounts may get trial credits

# Market Intelligence Arena: folder holding the real CSVs + report (read-only)
MARKET_DATA_DIR=C:\Users\jjard\Downloads

# Paid providers used by the Arena (health-check them in the Models/API before use)
OPENAI_API_KEY=
XAI_API_KEY=
# Experiential Labs gateway: use one key for any model slug your organization can call.
EXPLABS_API_KEY=
# Gemini also works with an existing GOOGLE_API_KEY if it is a valid Gemini key (read in place, never copied)

# Optional tuning (defaults shown)
# CLAUDE_BIN=            full path to claude.exe if the `claude` on PATH is a stale shim
# CLAUDE_TIMEOUT=240     CODEX_TIMEOUT=300     FREE_MODEL_TIMEOUT=60     FREE_MODEL_MAX_TOKENS=2000
# ARENA_MAX_TOKENS=4096  ARENA_TIMEOUT=300     (per contestant and judge call in the Arena)
